@page "/"
@inject NavigationManager navigationManager
@inject HttpService HttpServices

<div class="main-div">
    <div class="main-title-div"><h1>Validador de CPA</h1></div>
    <MudPaper Class="validated-content-mudpaper" Elevation="0">
        @if (qrCodeContent is not null)
        {
            <div class="validated-content-div" role="status">
                <MudText Align="Align.Center" Color="@(qrCodeContent.HasFailed ? Color.Error : Color.Success)">
                    @(qrCodeContent.HasFailed ? "Validação não confirmada" : "QR Code válido")
                </MudText>
                <MudText Align="Align.Center">@qrCodeContent.Mensagem</MudText>
                @if (!qrCodeContent.HasFailed && !string.IsNullOrEmpty(qrCodeContent.CodigoDigestFinal))
                {
                    <MudText Align="Align.Center">Identificador: <code>@qrCodeContent.CodigoDigestFinal</code></MudText>
                }
            </div>
            @if (!qrCodeContent.HasFailed)
            {
                <Aplicativo.Components.ValidationSummary Summary="qrCodeContent.Resumo" />
            }
        }
        @if (!string.IsNullOrEmpty(scannerMessage))
        {
            <MudText Align="Align.Center" role="status">@scannerMessage</MudText>
        }
    </MudPaper>
    <div class="validate-button-div">
        <MudButton Class="validate-button" EndIcon="@Icons.Material.Filled.CameraAlt"
                   FullWidth="true" Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="OpenScanner" Disabled="busy">@(busy ? "Aguarde..." : "Validar")</MudButton>
    </div>
    <div class="validate-button-div">
        <MudButton Class="history-button" EndIcon="@Icons.Material.Filled.History"
                   FullWidth="true" Variant="Variant.Filled" Color="Color.Secondary"
                   OnClick="@(() => navigationManager.NavigateTo("/history"))" Disabled="busy">Histórico</MudButton>
    </div>
</div>

@code {
    private QRCodePayload? qrCodeContent;
    private bool busy;
    private string? scannerMessage;
    private async Task OpenScanner()
    {
        if (busy) return;
        qrCodeContent = null;
        scannerMessage = null;
        if (!HttpServices.IsConfigured)
        {
            scannerMessage = "O endereço da API não foi configurado na publicação do aplicativo.";
            return;
        }
        busy = true;
        try
        {
            var permission = await Permissions.RequestAsync<Permissions.Camera>();
            if (permission != PermissionStatus.Granted)
            {
                scannerMessage = "Permita o acesso à câmera nas configurações do dispositivo para ler o QR Code.";
                return;
            }
            var scanner = new Scanner();
            await Application.Current!.Windows[0].Navigation.PushModalAsync(scanner);
            var codigo = await scanner.Completion;
            if (string.IsNullOrWhiteSpace(codigo))
            {
                scannerMessage = "Leitura cancelada.";
                return;
            }
            qrCodeContent = await HttpServices.CheckHash(codigo);
        }
        catch (Exception)
        {
            scannerMessage = "Não foi possível concluir a leitura. Confira a câmera, a conexão e o histórico antes de tentar novamente.";
        }
        finally
        {
            busy = false;
        }
    }
}
